{
  "apiVersion": 3,
  "name": "kashida/video-embed",
  "version": "1.4.24",
  "title": "Kashida Video Embed",
  "category": "embed",
  "icon": "video-alt3",
  "description": "Embed a video from a supported URL or provider embed code.",
  "textdomain": "kashida-video-embed",
  "attributes": {
    "url": {
      "type": "string",
      "default": ""
    },
    "ratio": {
      "type": "string",
      "default": "16:9"
    },
    "controls": {
      "type": "boolean",
      "default": true
    },
    "lazy": {
      "type": "boolean",
      "default": true
    }
  },
  "editorScript": "kve-block-editor",
  "render": "file:./render.php"
}
